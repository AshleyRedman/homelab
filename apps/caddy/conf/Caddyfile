# Mounted into the caddy container at /etc/caddy. Caddy gets TLS certs for
# *.ts.net from the host's tailscaled via its mounted socket.
#
# {$TS_HOSTNAME} comes from .env at the repo root (see .env.example).
# Apps are reached on localhost because the container uses host networking.

{$TS_HOSTNAME} {
	redir /jellyfin /jellyfin/
	redir /audiobookshelf /audiobookshelf/

	handle_path /jellyfin/* {
		reverse_proxy localhost:8096
	}

	handle_path /audiobookshelf/* {
		reverse_proxy localhost:13378
	}

	handle {
		respond "Caddy is up." 200
	}
}

# Apps that don't work under a sub-path get their own port instead.
# Home Assistant
{$TS_HOSTNAME}:8443 {
	reverse_proxy localhost:8123
}

# Dozzle
{$TS_HOSTNAME}:8444 {
	reverse_proxy localhost:8080
}
